AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=...
AZURE_CONTAINER_NAME=rw5data-turbine-edmij-entsoe

# Pipeline-only variables, needed when running pipeline/update_daily_data.py.
EDMIJ_USERNAME=
EDMIJ_PASSWORD=
EVIEW_USERNAME=
EVIEW_PASSWORD=
ENTSOE_TOKEN=

# InfluxDB v2 (turbine SCADA channels, e.g. AAP / active available power).
# Only needed by the InfluxDB fetch helpers in pipeline_lib.py.
IDB_URL=
IDB_TOKEN=
IDB_ORG=
IDB_BUCKET=
